  "JWT Sign": {
    "prefix": "jwtsign",
    "body": [
      "const ${1:token} = jwt.sign(",
      "\t{ ${2:id}: ${3:user._id} },",
      "\tprocess.env.${4:JWT_SECRET},",
      "\t{ expiresIn: '${5:1d}' }",
      ");"
    ],
    "description": "JWT sign"
  },
  "JWT Verify Middleware": {
    "prefix": "jwtverify",
    "body": [
      "const jwt = require('jsonwebtoken');",
      "const ${1:User} = require('../models/${1:User}');",
      "",
      "const protect = async (req, res, next) => {",
      "\tlet token;",
      "\tif (req.headers.authorization && req.headers.authorization.startsWith('Bearer')) {",
      "\t\ttry {",
      "\t\t\ttoken = req.headers.authorization.split(' ')[1];",
      "\t\t\tconst decoded = jwt.verify(token, process.env.JWT_SECRET);",
      "\t\t\treq.user = await ${1:User}.findById(decoded.id).select('-password');",
      "\t\t\tnext();",
      "\t\t} catch (error) {",
      "\t\t\treturn res.status(401).json({ success: false, message: 'Not authorized, token failed' });",
      "\t\t}",
      "\t}",
      "\tif (!token) {",
      "\t\treturn res.status(401).json({ success: false, message: 'Not authorized, no token' });",
      "\t}",
      "};",
      "",
      "module.exports = { protect };"
    ],
    "description": "Complete JWT middleware"
  },
