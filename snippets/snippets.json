  "Child Process Exec": {
    "prefix": "cpexec",
    "body": [
      "const { exec } = require('child_process');",
      "exec('${1:command}', (error, stdout, stderr) => {",
      "\tif (error) {",
      "\t\tconsole.error(`exec error: \\${error}`);",
      "\t\treturn;",
      "\t}",
      "\tconsole.log(`stdout: \\${stdout}`);",
      "\tconsole.error(`stderr: \\${stderr}`);",
      "});"
    ],
    "description": "child_process.exec"
  },
  "Child Process Spawn": {
    "prefix": "cpspawn",
    "body": [
      "const { spawn } = require('child_process');",
      "const ${1:child} = spawn('${2:command}', ['${3:arg1}']);",
      "${1:child}.stdout.on('data', (data) => console.log(`stdout: \\${data}`));",
      "${1:child}.stderr.on('data', (data) => console.error(`stderr: \\${data}`));",
      "${1:child}.on('close', (code) => console.log(`child process exited with code \\${code}`));"
    ],
    "description": "child_process.spawn"
  },
  "Cluster Setup": {
    "prefix": "cluster",
    "body": [
      "const cluster = require('cluster');",
      "const os = require('os');",
      "",
      "if (cluster.isPrimary) {",
      "\tconst numCPUs = os.cpus().length;",
      "\tfor (let i = 0; i < numCPUs; i++) cluster.fork();",
      "\tcluster.on('exit', (worker, code, signal) => {",
      "\t\tconsole.log(`worker \\${worker.process.pid} died`);",
      "\t\tcluster.fork();",
      "\t});",
      "} else {",
      "\t${1:// worker code e.g. app.listen()}",
      "\tconsole.log(`Worker \\${process.pid} started`);",
      "}"
    ],
    "description": "Cluster setup boilerplate"
